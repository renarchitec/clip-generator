{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "dokploy": {
        "type": "local",
        "command": ["npm", "exec", "--yes", "--package=@dokploy/mcp@latest", "--", "dokploy-mcp"],
        "environment": {
          "DOKPLOY_URL": "{env:DOKPLOY_URL}",
          "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}",
          "DOKPLOY_TOOL_PRESET": "deploy"
        }
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "-y", "shadcn@latest", "mcp"]
      }
    }
  }
}
