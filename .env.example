# --- API (Fase 1) ---
DATABASE_URL=postgresql://clipper:clipper@localhost:5432/clipper?schema=public
REDIS_URL=redis://localhost:6379
CLIPS_DIR=/data/clips
PORT=3000

# --- Auth & Mode Demo ---
ALLOW_REGISTRATION=true
# Role default pengguna baru: demo (terbatas) atau member (penuh)
REGISTRATION_DEFAULT_ROLE=demo
DEMO_DAILY_JOB_LIMIT=30
REGISTER_IP_DAILY_LIMIT=5
# Google Sign-In (opsional; fallback ke GOOGLE_CLIENT_ID/SECRET bila kosong)
# Redirect URI: PUBLIC_WEB_URL/api/auth/google/callback
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# --- Retensi file (Fase 2) ---
CLIP_TTL_HOURS=168
DOWNLOAD_GRACE_MINUTES=60

# --- Publikasi sosial (opsional; YouTube lebih dulu) ---
# Kunci AES-256: 32 byte dalam base64 (44 karakter) atau hex (64 karakter).
SOCIAL_TOKEN_KEY=
PUBLIC_WEB_URL=https://clipper.rencraft.site
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Instagram API with Instagram Login (Business/Creator); redirect: PUBLIC_WEB_URL/api/social/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Instagram API with Unified Login (Facebook Login for Business): isi config_id
# untuk memakai facebook.com/dialog/oauth + graph.facebook.com; kosongkan untuk
# tetap memakai Instagram Login lama.
INSTAGRAM_CONFIG_ID=

# --- Worker ---
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=
LLM_MODEL=
# Whisper memakai LLM_BASE_URL / LLM_API_KEY (9router) jika override ini kosong.
# 9router <=0.5.123 menghapus timestamp_granularities[]. Untuk sinkronisasi kata
# ~50 ms, set STT_BASE_URL=https://api.groq.com/openai/v1,
# STT_API_KEY=<groq-key>, dan STT_MODEL=whisper-large-v3-turbo.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=groq/whisper-large-v3-turbo
# Gemini tetap memakai LLM_BASE_URL / LLM_API_KEY (9router) secara default,
# lalu kredensial Whisper jika nilai LLM tidak ada. Isi override bila perlu.
STT_FALLBACK_BASE_URL=
STT_FALLBACK_API_KEY=
# Kosongkan STT_FALLBACK_MODEL untuk mematikan fallback Gemini audio.
STT_FALLBACK_MODEL=ag/gemini-4-hydrogen-low
MIN_FREE_GB=5

# --- Analytics (Umami, opsional) ---
# Web app (runtime SSR env di clipper-web)
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://stats.rencraft.site/script.js
# Landing page (build-time Vite env di apps/landing)
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://stats.rencraft.site/script.js
