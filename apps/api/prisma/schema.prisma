generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobMode {
  auto
  manual
}

enum JobStatus {
  queued
  running
  done
  failed
  cancelled
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  sessions       Session[]
  jobs           Job[]
  socialAccounts SocialAccount[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Job {
  id                String    @id @default(uuid())
  url               String
  description       String?
  mode              JobMode
  reframe           String    @default("face_tracking")
  captions          Boolean   @default(true)
  twoSpeakers       Boolean   @default(false)
  facecam           Boolean   @default(false)
  aspectRatio       String    @default("9:16")
  captionLanguage   String    @default("auto")
  clipCount         Int
  targetDurationSec Int
  maxSourceSec      Int?
  ranges            Json?
  status            JobStatus @default(queued)
  stage             String?
  progress          Int       @default(0)
  message           String?
  error             String?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  clips Clip[]

  @@index([userId])
  @@map("jobs")
}

model Clip {
  id           String    @id @default(uuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String
  startSec     Float
  endSec       Float
  filePath     String
  downloadedAt DateTime?
  deletedAt    DateTime?
  caption      String?
  hashtags     String[]   @default([])
  transcript   String?
  createdAt    DateTime  @default(now())

  publications Publication[]

  @@index([jobId])
  @@index([createdAt])
  @@map("clips")
}

enum SocialPlatform {
  youtube
  instagram
  tiktok
}

model SocialAccount {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  externalId      String
  displayName     String
  avatarUrl       String?
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  scopes          String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  publications Publication[]

  @@unique([userId, platform, externalId])
  @@index([userId])
  @@map("social_accounts")
}

enum PublicationStatus {
  queued
  uploading
  processing
  published
  failed
}

model Publication {
  id              String            @id @default(uuid())
  clipId          String
  clip            Clip              @relation(fields: [clipId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount     @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  mode            String            @default("direct")
  title           String            @default("")
  caption         String
  privacy         String
  options         Json?
  madeForKids     Boolean           @default(false)
  status          PublicationStatus @default(queued)
  progress        Int               @default(0)
  externalId      String?
  externalUrl     String?
  error           String?
  attempts        Int               @default(0)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([clipId])
  @@index([socialAccountId])
  @@index([status])
  @@map("publications")
}
