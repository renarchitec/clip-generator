generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobMode {
  auto
  manual
}

enum JobStatus {
  queued
  running
  done
  failed
  cancelled
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  sessions Session[]
  jobs     Job[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Job {
  id                String    @id @default(uuid())
  url               String
  description       String?
  mode              JobMode
  reframe           String    @default("face_tracking")
  captions          Boolean   @default(true)
  twoSpeakers       Boolean   @default(false)
  facecam           Boolean   @default(false)
  aspectRatio       String    @default("9:16")
  clipCount         Int
  targetDurationSec Int
  maxSourceSec      Int?
  ranges            Json?
  status            JobStatus @default(queued)
  stage             String?
  progress          Int       @default(0)
  message           String?
  error             String?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  clips Clip[]

  @@index([userId])
  @@map("jobs")
}

model Clip {
  id           String    @id @default(uuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String
  startSec     Float
  endSec       Float
  filePath     String
  downloadedAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([jobId])
  @@index([createdAt])
  @@map("clips")
}
