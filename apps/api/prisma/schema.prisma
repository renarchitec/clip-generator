generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobMode {
  auto
  manual
}

enum JobStatus {
  queued
  running
  done
  failed
  cancelled
}

enum UserRole {
  admin
  member
  demo
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  passwordHash     String?
  role             UserRole  @default(demo)
  googleId         String?   @unique
  authProvider     String    @default("email")
  avatarUrl        String?
  signupSource     String?
  utmSource        String?
  utmCampaign      String?
  contentType      String?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  /// Pengaturan watermark default: { watermarkId, x, y, scale, opacity } | null
  watermarkDefault Json?
  /// Outro default: { outroId } | null
  outroDefault     Json?

  sessions       Session[]
  jobs           Job[]
  socialAccounts SocialAccount[]
  watermarks     Watermark[]
  outros         Outro[]
  mediaAssets    MediaAsset[]
  briefHistory   BriefHistory[]
  events         UserEvent[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model UserEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, event])
  @@index([event, createdAt])
  @@map("user_events")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Job {
  id                String    @id @default(uuid())
  url               String
  primarySource     Json?
  splitScreen       Json?
  description       String?
  mode              JobMode
  reframe           String    @default("center_crop")
  captions          Boolean   @default(true)
  hookBanner        Boolean   @default(false)
  hookTemplate      String    @default("editorial")
  normalizeAudio    Boolean   @default(true)
  twoSpeakers       Boolean   @default(false)
  facecam           Boolean   @default(false)
  aspectRatio       String    @default("9:16")
  captionLanguage   String    @default("auto")
  transcriptSource  String    @default("youtube")
  customHashtags    String[]  @default([])
  /// Gaya subtitle kustom/template: CaptionStyle | null
  captionStyle      Json?
  clipCount         Int
  targetDurationSec Int
  maxSourceSec      Int?
  ranges            Json?
  /// Snapshot watermark: { watermarkId, filePath, x, y, scale, opacity } | null
  watermark         Json?
  /// Snapshot outro: { outroId, filePath, durationSec } | null
  outro             Json?
  status            JobStatus @default(queued)
  stage             String?
  progress          Int       @default(0)
  message           String?
  error             String?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  clips Clip[]

  @@index([userId])
  @@map("jobs")
}

model Watermark {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// relatif terhadap CLIPS_DIR, mis. watermarks/<userId>/<id>.png
  filePath    String
  mimeType    String
  width       Int
  height      Int
  durationSec Float?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("watermarks")
}

model Outro {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// relatif terhadap CLIPS_DIR, mis. outros/<userId>/<id>.mp4
  filePath    String
  mimeType    String
  durationSec Float
  width       Int
  height      Int
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("outros")
}

model MediaAsset {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// relatif terhadap CLIPS_DIR, mis. media/<userId>/<id>.mp4
  filePath    String
  mimeType    String
  durationSec Float
  width       Int
  height      Int
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("media_assets")
}

model BriefHistory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Maksimal 500 karakter setelah trim.
  text       String
  useCount   Int      @default(1)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@unique([userId, text])
  @@index([userId, lastUsedAt])
  @@map("brief_history")
}

model Clip {
  id           String    @id @default(uuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String
  startSec     Float
  endSec       Float
  filePath     String
  downloadedAt DateTime?
  deletedAt    DateTime?
  caption      String?
  hashtags     String[]  @default([])
  platformCaptions Json?
  transcript   String?
  viralScore   Int?
  hookText     String?
  createdAt    DateTime  @default(now())

  publications Publication[]

  @@index([jobId])
  @@index([createdAt])
  @@map("clips")
}

enum SocialPlatform {
  youtube
  instagram
  tiktok
}

model SocialAccount {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        SocialPlatform
  externalId      String
  displayName     String
  avatarUrl       String?
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  scopes          String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  publications Publication[]

  @@unique([userId, platform, externalId])
  @@index([userId])
  @@map("social_accounts")
}

enum PublicationStatus {
  queued
  uploading
  processing
  published
  failed
  scheduled
  cancelled
}

model Publication {
  id              String            @id @default(uuid())
  clipId          String
  clip            Clip              @relation(fields: [clipId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount?    @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  accountName     String?
  accountExternalId String?
  platform        SocialPlatform
  mode            String            @default("direct")
  title           String            @default("")
  caption         String
  privacy         String
  options         Json?
  madeForKids     Boolean           @default(false)
  status          PublicationStatus @default(queued)
  progress        Int               @default(0)
  externalId      String?
  externalUrl     String?
  error           String?
  attempts        Int               @default(0)
  viewCount        Int?
  likeCount        Int?
  commentCount     Int?
  metricsUpdatedAt DateTime?
  metricsError     String?
  publishedAt      DateTime?
  scheduledAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([clipId])
  @@index([socialAccountId])
  @@index([status])
  @@index([scheduledAt])
  @@map("publications")
}
